FROM docker.io/alpine:3.22.5 AS build
RUN apk add --no-cache \
      nodejs \
      npm
WORKDIR /build
# source is fetched by build.sh before this build starts (nexwall-ui is a
# private repo; the fetch needs the host's git/SSH credentials, which are not
# available inside this container's network namespace)
COPY src/ .
RUN npm ci \
    && sed -i 's/standalone/controller/g' .env.production \
    && npm run build

FROM docker.io/alpine:3.22.5 AS dist
RUN apk add --no-cache lighttpd
COPY entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
COPY --from=build /build/dist /var/www/localhost/htdocs
